# Configuración del Servidor y Base de Datos para TECNOPROYECTOS INGENIERÍA S.A.S.
PORT=5000
NODE_ENV=development

# Credenciales de Supabase (las obtienes en el panel de tu proyecto Supabase -> Project Settings -> API)
SUPABASE_URL=tu_supabase_url_aqui
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Configuración de Seguridad y Retención Documental (Decreto 1072 / Ley 527)
JWT_SECRET=clave_secreta_jwt_tecnoproyectos_2026
RETENTION_YEARS=20
